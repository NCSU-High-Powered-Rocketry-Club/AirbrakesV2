{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:best-practices",
    ":enablePreCommit"
  ],

  "labels": ["dependencies"],

  "bumpVersion": "patch",
  "rangeStrategy": "auto",

  "automerge": true,

  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,

  // Only run once a month:
  "schedule": ["before 3am on the first day of the month"],

  // Put basically everything into one PR:
  "packageRules": [
    {
      "groupName": "monthly dependency updates",
      "groupSlug": "monthly-deps",
      "matchPackageNames": ["*"]
    },

    {
      "matchPackageNames": ["python"],
      "enabled": false
    },

    {
      "matchUpdateTypes": ["major"],
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "automerge": false
    }
  ],

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"],
    "automerge": true
  }
}